<UserControl x:Class="GeroImperium.App.Views.ApplicationsPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:GeroImperium.App.ViewModels"
             xmlns:controls="clr-namespace:GeroImperium.App.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ApplicationsViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource ContentBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Applications" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="+ Add Application" Command="{Binding AddApplicationCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Delete" Appearance="Danger" Command="{Binding DeleteApplicationCommand}"
                               CommandParameter="{Binding SelectedApplication}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" MinHeight="420">
                    <Rectangle RadiusX="28" RadiusY="28" Fill="#33140F1F" Stroke="#4A3F63"
                               StrokeThickness="1.5" StrokeDashArray="4 3" />

                    <TextBlock Text="No applications yet -- click + Add Application to create one"
                               FontStyle="Italic" Opacity="0.6" Foreground="White" Margin="24"
                               Visibility="{Binding SelectedApplication, Converter={StaticResource NullToVisibleConverter}}" />

                    <ListBox ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}"
                             Background="Transparent" BorderThickness="0" Margin="24"
                             VerticalAlignment="Top" HorizontalAlignment="Left"
                             ItemContainerStyle="{StaticResource GalleryTileItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ApplicationItemViewModel}">
                                <StackPanel Width="120">
                                    <Border Width="120" Height="120" CornerRadius="12"
                                            Background="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}">
                                        <Image Source="{Binding ImagePreview}" Width="76" Height="76"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18"
                        VerticalAlignment="Top" MinHeight="420">
                    <Grid>
                        <TextBlock Text="No application selected" FontStyle="Italic" Opacity="0.6" Foreground="White"
                                   Visibility="{Binding SelectedApplication, Converter={StaticResource NullToVisibleConverter}}" />

                        <StackPanel DataContext="{Binding SelectedApplication}"
                                    Visibility="{Binding Path=DataContext.SelectedApplication, ElementName=Root, Converter={StaticResource NotNullToVisibleConverter}}">
                            <Border Width="120" Height="120" CornerRadius="12" HorizontalAlignment="Left"
                                    Background="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}">
                                <Image Source="{Binding ImagePreview}" Width="88" Height="88" Stretch="Uniform" />
                            </Border>

                            <ui:Button Content="Pick Image..." Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                       Command="{Binding DataContext.PickImageCommand, ElementName=Root}"
                                       CommandParameter="{Binding}" />

                            <TextBlock Text="Name" Margin="0,14,0,4" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Background" Margin="0,14,0,4" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            <controls:ColorSwatchPicker SelectedColor="{Binding BackgroundColor}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
