<UserControl x:Class="GeroImperium.App.Views.SyncPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:GeroImperium.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SyncViewModel}"
             mc:Ignorable="d">
    <StackPanel Margin="16" MaxWidth="640" HorizontalAlignment="Left">

        <TextBlock Text="Connection" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
        <TextBlock Text="Device IP address" Opacity="0.7" Margin="0,0,0,2" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <ui:TextBox Width="160" Text="{Binding DeviceIpAddress, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="192.168.1.22" Margin="0,0,8,0" />
            <ui:Button Content="Connect" Command="{Binding ConnectCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,4" />
        <TextBlock Text="{Binding BleStatusText}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,16" />

        <TextBlock Text="Sync" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" />
        <TextBlock Text="Pushes changed/new local Applications/Key Groups/Keys/Shortcuts to the device over REST and deletes anything removed locally that was already on the device. Unchanged rows are skipped. Safe to re-run or interrupt; nothing here is destructive to the device."
                   TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8" />
        <ui:Button Content="Sync Now" Command="{Binding SyncCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" Margin="0,0,0,4" />
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBlock Text="Maintenance" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" />
        <TextBlock Text="These replace data instead of merging it. Each asks for confirmation before doing anything."
                   TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal">
            <ui:Button Content="Full Sync (wipe device + push clean copy)" Command="{Binding FullSyncCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Pull from Device (backs up local data first)" Command="{Binding PullFromDeviceCommand}" Margin="0,0,8,0" />          
        </StackPanel >
        <StackPanel Orientation="Horizontal" Margin="0,10">
            <ui:Button Content="Backup Local DB..." Command="{Binding BackupNowCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Restore Backup..." Command="{Binding RestoreBackupCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
