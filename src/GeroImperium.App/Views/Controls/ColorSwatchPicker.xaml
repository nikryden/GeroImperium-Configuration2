<UserControl x:Class="GeroImperium.App.Views.Controls.ColorSwatchPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <StackPanel Orientation="Vertical">
        <WrapPanel x:Name="SwatchPanel" MaxWidth="220" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Border Width="26" Height="26" BorderBrush="Gray" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                <Border.Background>
                    <SolidColorBrush x:Name="PreviewBrushElement" Color="Transparent" />
                </Border.Background>
            </Border>
            <ui:TextBox x:Name="HexTextBox" Width="100" PlaceholderText="#RRGGBB"
                        LostFocus="HexTextBox_LostFocus" KeyDown="HexTextBox_KeyDown" />
            <ui:Button Content="Clear" Margin="8,0,0,0" Click="ClearButton_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
