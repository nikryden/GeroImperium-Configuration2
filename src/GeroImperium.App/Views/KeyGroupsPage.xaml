<UserControl x:Class="GeroImperium.App.Views.KeyGroupsPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:GeroImperium.App.ViewModels"
             xmlns:controls="clr-namespace:GeroImperium.App.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:KeyGroupsViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource ContentBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="BannerNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="16" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Width="200" ItemsSource="{Binding Applications}"
                          DisplayMemberPath="Name" SelectedItem="{Binding SelectedApplication}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="▲" Width="36" Margin="0,0,4,0" ToolTip="Move group earlier"
                               Command="{Binding MoveKeyGroupEarlierCommand}" />
                    <ui:Button Content="▼" Width="36" Margin="0,0,16,0" ToolTip="Move group later"
                               Command="{Binding MoveKeyGroupLaterCommand}" />
                    <ui:Button Content="+ Add Group" Command="{Binding AddKeyGroupCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Delete" Appearance="Danger" Command="{Binding DeleteKeyGroupCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,0,0,20" CornerRadius="10" Padding="8,8,8,8"
                    Background="{StaticResource BannerGradientBrush}"
                    Visibility="{Binding SelectedApplication, Converter={StaticResource NotNullToVisibleConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="&#8249;" Command="{Binding PreviousKeyGroupCommand}"
                            Style="{StaticResource BannerNavButtonStyle}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,0">
                        <Border Width="40" Height="40" CornerRadius="8" Background="#33FFFFFF" Margin="0,0,12,0">
                            <Image Source="{Binding SelectedApplication.ImageData, Converter={StaticResource ImageBytesToImageSourceConverter}}"
                                   Width="26" Height="26" />
                        </Border>
                        <TextBlock Text="{Binding SelectedApplication.Name, Mode=OneWay}" FontWeight="Bold" FontSize="16"
                                   Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Text=" · " FontSize="16" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                        <ui:TextBox Text="{Binding SelectedKeyGroupName, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="14" MinWidth="140" VerticalAlignment="Center"
                                    PlaceholderText="Group name" ToolTip="Rename this key group" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="&#8250;" Command="{Binding NextKeyGroupCommand}"
                            Style="{StaticResource BannerNavButtonStyle}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="No key group selected" FontStyle="Italic" Opacity="0.6" Foreground="White"
                           VerticalAlignment="Top" HorizontalAlignment="Left"
                           Visibility="{Binding SelectedKeyGroup, Converter={StaticResource NullToVisibleConverter}}" />

                <Grid Grid.Column="0" Width="540" Height="420" VerticalAlignment="Top"
                      Visibility="{Binding SelectedKeyGroup, Converter={StaticResource NotNullToVisibleConverter}}">
                    <Rectangle RadiusX="28" RadiusY="28" Fill="#33140F1F" Stroke="#4A3F63"
                               StrokeThickness="1.5" StrokeDashArray="4 3" />

                    <ListBox ItemsSource="{Binding KeySlots}" SelectedItem="{Binding SelectedKeySlot}"
                             Background="Transparent" BorderThickness="0" Margin="24"
                             ItemContainerStyle="{StaticResource GalleryTileItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Rows="2" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KeySlotViewModel}">
                                <Border Width="140" Height="140" CornerRadius="12"
                                        Background="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}">
                                    <Image Source="{Binding ImagePreview}" Width="88" Height="88"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18"
                        VerticalAlignment="Top" MinHeight="420"
                        Visibility="{Binding SelectedKeyGroup, Converter={StaticResource NotNullToVisibleConverter}}">
                    <Grid>
                        <TextBlock Text="No key selected" FontStyle="Italic" Opacity="0.6" Foreground="White"
                                   Visibility="{Binding SelectedKeySlot, Converter={StaticResource NullToVisibleConverter}}" />

                        <StackPanel DataContext="{Binding SelectedKeySlot}"
                                    Visibility="{Binding Path=DataContext.SelectedKeySlot, ElementName=Root, Converter={StaticResource NotNullToVisibleConverter}}">
                            <ui:Button Content="Pick Image..." HorizontalAlignment="Stretch"
                                       Command="{Binding DataContext.PickImageCommand, ElementName=Root}"
                                       CommandParameter="{Binding}" />

                            <TextBlock Text="Background" Margin="0,14,0,4" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            <controls:ColorSwatchPicker SelectedColor="{Binding BackgroundColor}" />

                            <TextBlock Text="Action" Margin="0,14,0,4" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox ItemsSource="{Binding ActionTypeOptions}" SelectedItem="{Binding ActionType}" />

                            <TextBlock Text="Requires firmware update + Service running (not yet available)"
                                       Foreground="Orange" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                       Visibility="{Binding IsUnsupportedActionType, Converter={StaticResource BoolToVisibleConverter}}" />

                            <StackPanel Visibility="{Binding ActionType, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Shortcut}">
                                <TextBlock Text="Shortcut" Margin="0,14,0,4" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding ChordPreview}" FontStyle="Italic" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8" />

                                <ItemsControl ItemsSource="{Binding ChordSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChordStepEditorViewModel}">
                                            <Border Background="#22FFFFFF" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Step" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                                                        <ui:Button Grid.Column="1" Content="✕" Width="22" Height="22" Padding="0"
                                                                   ToolTip="Remove this step"
                                                                   Command="{Binding DataContext.RemoveChordStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}" />
                                                    </Grid>

                                                    <UniformGrid Columns="2" Margin="0,4,0,6">
                                                        <CheckBox Content="Ctrl" IsChecked="{Binding Ctrl}" />
                                                        <CheckBox Content="Shift" IsChecked="{Binding Shift}" />
                                                        <CheckBox Content="Alt" IsChecked="{Binding Alt}" />
                                                        <CheckBox Content="Win" IsChecked="{Binding Win}" />
                                                    </UniformGrid>

                                                    <ComboBox ItemsSource="{Binding FilteredKeys}"
                                                              Text="{Binding KeySearchText, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedItem="{Binding SelectedKey}"
                                                              IsSynchronizedWithCurrentItem="False"
                                                              IsEditable="True"
                                                              IsTextSearchEnabled="False"
                                                              StaysOpenOnEdit="True"
                                                              ToolTip="Type to search keys: letters, digits, F1-F12, arrows, ENTER, ESC, etc." />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ui:Button Content="+ Add step" HorizontalAlignment="Stretch"
                                           Command="{Binding AddChordStepCommand}"
                                           ToolTip="Add another chord step, e.g. for a two-key sequence like Ctrl+K, Ctrl+C" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding ActionType, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=LaunchApp}">
                                <TextBlock Text="Launch path" Margin="0,14,0,4" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                <ui:TextBox Text="{Binding LaunchPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="C:\path\to\app.exe" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
